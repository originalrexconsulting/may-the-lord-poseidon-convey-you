#!/usr/bin/env python3
"""A stand-in ssh for the --host tests: the "box" is this machine, the "remote" command runs here.

Enough of ssh's grammar: -o X (ControlPath=... noted), -S X, -N (a master), -M, -L spec, -O cmd,
the host, then the command. A master writes its pid to the control path and sleeps; -O check
tests that pid; -O exit kills it and the relay; -O forward -L a:b starts a unix-socket relay a->b
in the background that closes the client when b is missing, as sshd does, and answers ok when
one is already up, as the real mux does. A plain command execs `sh -c`, which is what the box's
shell would do with it. FAKE_SSH_LOG records every argv; FAKE_SSH_PAREC=sine replaces parec with
an endless 60 Hz s16le stereo stream, paced to real time.
"""
import math
import os
import signal
import socket
import struct
import sys
import threading
import time


def parse(args):
    ctl = fwd = octl = host = None
    master = False
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-o":
            if args[i + 1].startswith("ControlPath="):
                ctl = args[i + 1][len("ControlPath="):]
            i += 2
        elif a == "-S":
            ctl = args[i + 1]
            i += 2
        elif a == "-L":
            fwd = args[i + 1]
            i += 2
        elif a == "-O":
            octl = args[i + 1]
            i += 2
        elif a == "-N":
            master = True
            i += 1
        elif a == "--":
            i += 1
            break
        elif a.startswith("-"):
            i += 1
        elif host is None:
            host = a
            i += 1
        else:
            break
    return ctl, fwd, octl, host, master, args[i:]


def pid_in(path):
    try:
        with open(path) as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def alive(pid):
    try:
        os.kill(pid, 0)
        with open(f"/proc/{pid}/stat") as f:
            return pid > 0 and f.read().rsplit(")", 1)[1].split()[0] != "Z"   # a zombie answers kill 0
    except OSError:
        return False


def kill(path):
    for p in (path, path + ".fwd"):
        pid = pid_in(p)
        if alive(pid):
            os.kill(pid, signal.SIGTERM)
        try:
            os.unlink(p)
        except OSError:
            pass


def relay(ctl, spec):
    """Background: listen on the local socket, connect each client through to the remote one."""
    if alive(pid_in(ctl + ".fwd")):
        return                      # "found existing forwarding"
    local, remote = spec.split(":", 1)
    if os.fork():
        return                      # the parent (the -O forward call) returns at once
    os.setsid()
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)        # or the caller's capture_output would wait on these pipes
    with open(ctl + ".fwd", "w") as f:
        f.write(str(os.getpid()))
    try:
        os.unlink(local)
    except OSError:
        pass
    srv = socket.socket(socket.AF_UNIX)
    srv.bind(local)
    srv.listen(8)

    def pump(a, b):
        try:
            while True:
                d = a.recv(65536)
                if not d:
                    break
                b.sendall(d)
        except OSError:
            pass
        for s in (a, b):
            try:
                s.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

    while True:
        c, _ = srv.accept()
        r = socket.socket(socket.AF_UNIX)
        try:
            r.connect(remote)
        except OSError:
            c.close()               # sshd: "connect failed", and the channel closes
            continue
        threading.Thread(target=pump, args=(c, r), daemon=True).start()
        threading.Thread(target=pump, args=(r, c), daemon=True).start()


def sine():
    rate, hz, n = 44100, 60.0, 1024
    t0, i, out = time.time(), 0, sys.stdout.buffer
    while True:
        frames = [int(12000 * math.sin(2 * math.pi * hz * (i + k) / rate)) for k in range(n)]
        out.write(struct.pack(f"<{2 * n}h", *[v for s in frames for v in (s, s)]))
        out.flush()
        i += n
        time.sleep(max(0, t0 + i / rate - time.time()))


def main():
    ctl, fwd, octl, host, master, cmd = parse(sys.argv[1:])
    log = os.environ.get("FAKE_SSH_LOG")
    if log:
        with open(log, "a") as f:
            f.write(" ".join(sys.argv[1:]) + "\n")
    if octl == "check":
        sys.exit(0 if alive(pid_in(ctl)) else 255)
    if octl == "exit":
        kill(ctl)
        sys.exit(0)
    if octl == "forward":
        relay(ctl, fwd)
        sys.exit(0)
    if master:
        with open(ctl, "w") as f:
            f.write(str(os.getpid()))
        signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
        while True:
            time.sleep(3600)
    if cmd and cmd[0] == "parec" and os.environ.get("FAKE_SSH_PAREC") == "sine":
        try:
            sine()
        except (BrokenPipeError, KeyboardInterrupt):
            sys.exit(0)
    os.execvp("sh", ["sh", "-c", " ".join(cmd)])


if __name__ == "__main__":
    main()
